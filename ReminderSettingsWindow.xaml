<Window x:Class="DittoBuddy.ReminderSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="리마인더 설정" Width="340" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" Topmost="True">
    <StackPanel Margin="14">
        <CheckBox x:Name="WorkScheduleCheck" Content="근무시간 알림 사용 (점심/퇴근 5분 전)" Margin="0,0,0,10"/>
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="점심시작 (HH:mm)" VerticalAlignment="Center"/>
            <TextBox x:Name="LunchStartBox" Grid.Column="1" Margin="8,2" Text="12:00"/>
        </Grid>
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="퇴근시간 (HH:mm)" VerticalAlignment="Center"/>
            <TextBox x:Name="WorkEndBox" Grid.Column="1" Margin="8,2" Text="18:00"/>
        </Grid>

        <Separator Margin="0,0,0,10"/>

        <TextBlock Text="사용자 지정 리마인더" FontWeight="Bold" Margin="0,0,0,6"/>
        <ListBox x:Name="ReminderList" Height="120" Margin="0,0,0,8"/>
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="NewTimeBox" Text="09:00"/>
            <TextBox x:Name="NewTextBox" Grid.Column="1" Margin="4,0" Text="내용 입력"/>
            <Button Grid.Column="2" Content="추가" Click="AddReminder_Click"/>
        </Grid>
        <Button Content="선택 삭제" HorizontalAlignment="Left" Click="RemoveReminder_Click" Margin="0,0,0,14"/>

        <Button Content="닫기" Width="70" HorizontalAlignment="Right" Click="CloseButton_Click"/>
    </StackPanel>
</Window>
