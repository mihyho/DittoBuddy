<Window x:Class="DittoBuddy.SpeechBubbleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DittoBuddy" SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" WindowStartupLocation="Manual"
        ResizeMode="NoResize" MouseLeftButtonUp="Window_MouseLeftButtonUp">
    <StackPanel>
        <Border Background="White" BorderBrush="#CBC0EC" BorderThickness="2" CornerRadius="14" Padding="14,10" MaxWidth="220">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.2" Color="#6B5B95"/>
            </Border.Effect>
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="13" FontWeight="Bold"
                       Foreground="#3A3040" TextAlignment="Center"/>
        </Border>
        <Path Data="M 10,0 L 26,0 L 14,14 Z" Fill="White" Stroke="#CBC0EC" StrokeThickness="2"
              HorizontalAlignment="Left" Margin="24,-2,0,0"/>
    </StackPanel>
</Window>
