<Window x:Class="DittoBuddy.ShortcutsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="바로가기 관리" Width="300" Height="320"
        WindowStartupLocation="CenterScreen" Topmost="True">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="추가..." Width="70" Margin="4,0" Click="AddButton_Click"/>
            <Button Content="삭제" Width="70" Margin="4,0" Click="RemoveButton_Click"/>
            <Button Content="닫기" Width="70" Margin="4,0" Click="CloseButton_Click"/>
        </StackPanel>
        <ListBox x:Name="ShortcutList" DisplayMemberPath="Name"/>
    </DockPanel>
</Window>
