<Window x:Class="DittoBuddy.StopwatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="스톱워치" Width="220" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" Topmost="True" ResizeMode="NoResize">
    <StackPanel Margin="12" HorizontalAlignment="Center">
        <TextBlock x:Name="TimeText" Text="00:00.0" FontSize="32" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,12"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="StartStopButton" Content="시작" Width="60" Margin="4" Click="StartStopButton_Click"/>
            <Button Content="초기화" Width="60" Margin="4" Click="ResetButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
