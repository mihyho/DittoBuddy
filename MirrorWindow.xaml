<Window x:Class="DittoBuddy.MirrorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="거울" Width="560" Height="355" MinWidth="280" MinHeight="180"
        WindowStartupLocation="CenterScreen" Topmost="True"
        Background="#18151E">
    <Grid x:Name="ContentGrid" ClipToBounds="True">
        <!-- Webcam video display: horizontally mirrored (ScaleX = -1) like a real mirror -->
        <Image x:Name="CameraImage" Stretch="UniformToFill" RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform>
                <ScaleTransform ScaleX="-1" ScaleY="1"/>
            </Image.RenderTransform>
        </Image>

        <!-- Brief toast for mouse wheel brightness fine-tuning -->
        <Border x:Name="ToastBorder" Background="#99000000" CornerRadius="12" Padding="12,6"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16"
                Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock x:Name="ToastText" Text="밝기: 100%" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
        </Border>

        <!-- Status message (connecting or error) -->
        <StackPanel x:Name="StatusPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
            <TextBlock x:Name="StatusText" Text="카메라 연결 중..." Foreground="#D6CBE8"
                       FontSize="14" FontWeight="Medium" TextAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>
